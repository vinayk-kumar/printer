# systemd unit for the Print Agent cloud dashboard. Install:
#   sudo useradd --system --home-dir /var/lib/print-cloud --shell /usr/sbin/nologin print-cloud
#   sudo cp deploy/print-cloud.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now print-cloud
[Unit]
Description=Print Agent cloud dashboard
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/print-cloud serve --addr 127.0.0.1:8080 --db /var/lib/print-cloud/print-cloud.db
User=print-cloud
Group=print-cloud
StateDirectory=print-cloud
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
